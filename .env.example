# The server's environment. Copy to .env for local runs (`set -a; . ./.env; set +a`), and set the same names as
# variables of the cityloom service on Railway. Never commit real values.

# Where the site is, with no trailing path. Redirect URLs and the Origin check are built from it.
BASE_URL=http://127.0.0.1:8137
# Postgres. On Railway: a reference to the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cityloom

# Keys. Losing DATA_KEYS or LOOKUP_KEY loses every account's data: keep copies in a password manager, not only here.
# 64 random bytes, base64:  openssl rand -base64 64 | tr -d '\n'
COOKIE_KEY=
# Versioned 256-bit master keys, id:base64, comma separated; one key to begin with:
#   echo "1:$(openssl rand -base64 32)"
DATA_KEYS=
# The id in DATA_KEYS that seals new data keys. To rotate: add "2:<base64>", set this to 2, run `cityloom_server rewrap`.
DATA_KEY_CURRENT=1
# 256 bits, base64:  openssl rand -base64 32.  To rotate: set OLD_LOOKUP_KEY to the old one, then `cityloom_server rehash`.
LOOKUP_KEY=
# OLD_LOOKUP_KEY=

# Providers: each is offered only when all its variables are set. Redirect URLs: BASE_URL + /auth/<osm|google|microsoft|apple>/callback
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Apple: the Services ID, the team id, the key id and the .p8 file's text (PEM, with \n for its line breaks if the host wants one line).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# The static server (as before): E2E_HOST (default 127.0.0.1), E2E_PORT or PORT (default 8137), WEB_ROOT (default web),
# CACHE_CONTROL (default no-store).

# Tests only, with a server built --features test-provider: offers the fake provider; raises the /auth allowance.
# FAKE_PROVIDER=1
# AUTH_RATE_BURST=20
# AUTH_RATE_PERIOD_SECS=6

# Log filter (default info), for example RUST_LOG=cityloom_server=debug.
# RUST_LOG=info
