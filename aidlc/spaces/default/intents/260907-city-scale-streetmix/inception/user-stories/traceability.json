    { "id": "NFR6.1", "status": "N/A", "target": "A repository practice enforced by push protection and the CI secret scan in team-practices.md. No user-facing behaviour to write a story against." },
    { "id": "NFR6.2", "status": "OK", "target": "US10.1" },
    { "id": "NFR6.3", "status": "N/A", "target": "A constraint on what may be collected. Satisfied by the absence of any story that collects payment or special-category data; verifiable by inspecting the story set rather than by a story of its own." },

    { "id": "NFR7.1", "status": "N/A", "target": "An engineering coverage floor measured in CI, not user-observable behaviour. Owned by build-and-test." },
    { "id": "NFR7.2", "status": "N/A", "target": "A dependency-pinning build practice. Owned by ci-pipeline and the affirmed mandate in project.md. AC3.1.5 asserts the pinned crate is actually invoked, which is the behavioural half." },
    { "id": "NFR7.3", "status": "N/A", "target": "A defect-handling practice. Owned by build-and-test." }
