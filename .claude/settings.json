{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/factory/guard.py\"; [ ! -f \"$f\" ] || python3 \"$f\""
          }
        ]
      }
    ]
  }
}
