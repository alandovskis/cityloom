{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make build)", "Bash(make test*)", "Bash(./scripts/*)",
      "Bash(git add*)", "Bash(git commit*)", "Bash(git checkout*)",
      "Read", "Edit", "Write", "Glob", "Grep"
    ],
    "deny": [
      "Bash(git push*)", "Bash(rm -rf*)", "Bash(curl*)", "Bash(wget*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command",
          "command": "just format \"$CLAUDE_FILE_PATHS\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash(git commit*)",
        "hooks": [{ "type": "command",
          "command": "just verify" }] }
    ]
  }
}
