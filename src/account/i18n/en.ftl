# What the Account page says (src/account/view.rs, src/account/vm.rs).
account-page-heading = Your account
account-signed-in-as = Signed in as { $name }
account-loading = Loading your account…
account-signed-out = You are signed out.
account-signed-out-help = Sign in to see and change your account.
account-sign-in-with = Sign in with
account-unavailable = Accounts are not available right now. Everything else in CityLoom still works.
account-sign-out = Sign out
account-linked-heading = Linked sign-ins
account-linked-note = You can sign in with any of these.
account-identity = { $provider } ({ $label })
account-identity-bare = { $provider }
account-unlink = Unlink
account-unlink-named = Unlink { $what }
account-unlinked = Sign-in unlinked.
account-only-one = This is your only sign-in, so it cannot be unlinked.
account-link-heading = Link another sign-in
account-link-with = Link { $provider }
account-link-note = You can also link a second account from a provider you already use; the labels tell them apart.
account-storage-heading = Where is your work kept?
account-storage-lead = Choose one. You can change it later on this page.
account-storage-device = Keep my work on this device only
account-storage-device-help = Nothing you make is sent to the server. You cannot share it except by printing it.
account-storage-server = Store my work on the server
account-storage-server-help = Your work is kept on the server, encrypted, so it follows you and can be shared.
account-storage-set-device = Your work will be kept on this device only.
account-storage-set-server = Your work will be stored on the server.
account-delete-heading = Delete your account
account-delete = Delete account…
account-delete-confirm-heading = Delete your account?
account-delete-warning = This removes your account, your linked sign-ins and everything stored under them from the server at once. Copies in the server’s backups are removed when those backups expire, according to Railway’s retention period. Work kept on this device is not affected.
account-delete-yes = Delete my account
account-delete-no = Keep my account
account-deleted = Your account was deleted.
account-failed = That did not work. Try again.
