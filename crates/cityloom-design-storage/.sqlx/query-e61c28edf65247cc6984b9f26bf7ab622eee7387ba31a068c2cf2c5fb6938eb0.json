  "query": "\n        SELECT stored_design_id, anonymous_design_id, owner_account_id,\n               payload, created_at, expires_at\n        FROM stored_designs\n        WHERE anonymous_design_id = $1\n          AND (expires_at IS NULL OR expires_at > now())\n        ",
