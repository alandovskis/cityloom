{
  "_comment": "Which browser specs (e2e/tests/*.spec.ts) a pull request runs, by the files it changes. The first rule that matches a file decides it; `all` runs every spec, `none` runs none (the change is covered by the unit tests alone), `docs` marks documentation (a pull request of nothing else skips the Rust and browser jobs), `self` is the changed spec itself, and `@name` is a group below. A file no rule matches runs every spec. `**` crosses folders, `*` does not. Main always runs every spec: this file only narrows a pull request. e2e/tiers.json then gives each chosen spec its tier (ui, integration, e2e), and a tier with no chosen spec does not run: that is how editor code starts no Postgres and no archive, and cityloom_prepare runs the E2E tier alone. scripts/include/tests/test_ci_changes.py fails when a spec is in no group or a source folder has no rule.",
  "groups": {
    "street": ["street", "street-iso", "edits", "impact", "speed", "templates", "calming", "curb", "stops", "green"],
    "junction": ["junction", "junction-a11y"],
    "map": ["map", "network", "source-quality", "restrictions", "world", "report", "search", "webgl"],
    "home": ["home", "home-search"],
    "account": ["account", "account-server"],
    "sync": ["sync"],
    "archive": ["archive", "design-archive"],
    "cross": ["a11y", "editors", "focus-touch", "footer", "language", "shell"],
    "static": ["delivery", "serve"]
  },
  "rules": [
    { "paths": ["website/**", "docs/**", "**/*.md", "LICENSE*"], "docs": true },
    { "paths": ["e2e/tests/*.spec.ts"], "specs": "self" },
    { "paths": ["**/tests.rs", "src/i18n_guard.rs", "scripts/include/tests/**", "cityloom_*/tests/**", "osm_import/tests/**", ".github/ISSUE_TEMPLATE/**", ".github/labels.yml", ".github/issue-labeler.yml", ".github/issue-flow.json", ".github/dependabot.yml", "sonar-project.properties"], "specs": "none" },
    { "paths": ["src/street/**"], "specs": ["@street", "@junction", "@map", "@cross"] },
    { "paths": ["src/junction/**"], "specs": ["@junction", "@cross"] },
    { "paths": ["src/map/**", "src/place/**"], "specs": ["@map", "@home", "@cross"] },
    { "paths": ["src/restriction/**"], "specs": ["@map", "@street"] },
    { "paths": ["src/sync/**"], "specs": ["@sync", "@account", "@cross"] },
    { "paths": ["src/account/**"], "specs": ["@account", "@cross"] },
    { "paths": ["src/archive/**"], "specs": ["@archive", "@cross"] },
    { "paths": ["cityloom_prepare/**"], "specs": ["archive"] },
    { "paths": ["cityloom_report/**", "cityloom_report_pdf/**"], "specs": ["@map"] },
    { "paths": ["src/city/**", "src/shared/**", "src/shell/**", "src/lib.rs", "src/atlas_contract.rs", "osm_import/**", "cityloom_model/**", "cityloom_server/**", "web/**", "e2e/**", "scripts/**", "deploy/**", "justfile", "Cargo.toml", "Cargo.lock", ".github/**", "package.json", "package-lock.json", "rustfmt.toml", ".prettierrc.json", ".prettierignore", ".gitignore", ".env.example"], "specs": "all" }
  ]
}
