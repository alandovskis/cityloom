# RustRover and the other JetBrains IDEs: keep what the team can share (code style,
# inspection profiles, run configurations), not what the IDE generates per machine.
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/runConfigurations/
*.iml
*.iws
.idea_modules/
