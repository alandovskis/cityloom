erDiagram
    METROPOLITAN_REGION ||--|| NETWORK : "network"

    NETWORK ||--o{ NODE_DEF : nodes
    NETWORK ||--o{ EDGE_DEF : edges
    NETWORK ||--o{ STREET : "streets (by edge uid)"
    NETWORK ||--o{ JUNCTION_STATE : "junctions (by node uid)"
    NETWORK ||--o{ STREET : "today_streets"
    NETWORK ||--o{ JUNCTION_STATE : "today_junctions"
    NODE_DEF ||--o| NAMES : "names (sample only)"
    EDGE_DEF }o--|| NODE_DEF : "a"
    EDGE_DEF }o--|| NODE_DEF : "b"
    EDGE_DEF |o--o| STREET : "section (imported)"
    EDGE_DEF }o--|| CATALOGUE_STREET : "street (sample idx)"

    STREET ||--o{ SEGMENT : segments
    STREET }o--|| CATALOGUE_STREET : "sample"
    SEGMENT ||--|{ SEGMENT_TIMES : "times of day (windows never overlap, cover the day)"
    SEGMENT_TIMES }o--|| SEGMENT_KIND : kind
    SEGMENT }o--|| MATERIAL : material
    SEGMENT }o--o| CURB : curb
    SEGMENT_TIMES }o--|| MATERIAL : material
    SEGMENT_KIND }o--|{ MATERIAL : "allowed materials (first is default)"
    SEGMENT_KIND }o--o{ CURB : "allowed curbs"

    JUNCTION_STATE ||--o{ ARM : arms
    ARM }o--o| EDGE_DEF : "edge (uid; 0 = sample)"
    ARM }o--|| CATALOGUE_STREET : "street"
    ARM |o--o| STREET : "section (not saved)"
    ARM ||--o{ LANE : lanes
    ARM |o--o| CROSSING : crossing

    METROPOLITAN_REGION {
        string name
    }
    NETWORK {
        Side side
        f64x2 origin_m "optional lon/lat anchor"
        BTreeMap streets
        BTreeMap junctions
        BTreeMap today_streets
        BTreeMap today_junctions
    }
    NODE_DEF {
        i32 x_mm
        i32 y_mm
        bool junction
        Control control
        i32 corner_mm
    }
    EDGE_DEF {
        usize a FK
        usize b FK
        usize street FK
        string name "optional"
        f64x2 headings "optional"
        i32x2_list shape "optional centreline mm"
    }
    STREET {
        usize sample FK
        string name "optional"
        i32 row_mm
        u32 next_uid
    }
    SEGMENT {
        u32 uid
        i32 width_mm
        string material FK
        string curb FK "optional"
        Direction direction "optional"
        bool tram
    }
    SEGMENT_TIMES {
        string kind FK
        string material FK
        Direction direction "optional"
        i32 from_min "minute of day, included"
        i32 to_min "excluded; before from_min wraps midnight"
    }
    SEGMENT_KIND {
        string id PK "sidewalk, planting, bike, travel, bus, parking, median, loading, shoulder, bikerack, bikeshare, pole, busshelter, busstation, bench, terrace, streetlamp"
        string name
        string mark "two-letter sheet mark"
        Mode mode "foot, bike, transit, vehicle, green"
        i32 default_mm
        i32 min_mm
        i32 max_mm
        i32 people_per_hour_per_m "synthetic"
        bool has_curb
        DirectionRule direction_rule "none, required, optional"
        bool shares_road "may change type through the day"
    }
    MATERIAL {
        string id PK "asphalt, concrete, permeable, brick, grass, planted, gravel, trees"
        string name
    }
    CURB {
        string id PK "granite, concrete, asphalt, planted, kassel, bikefriendly, island"
        string name
    }
    JUNCTION_STATE {
        string label
        Control control
        i32 ring_extra_mm
        u32x2 bus "optional"
        i32 cycle "optional"
    }
    ARM {
        u32 uid
        usize street FK
        u32 edge FK
        i32 bearing
        i32 offset_mm
        i32 corner_mm
        bool bulb_x2
        u32_list banned
        bool bus_lane
        Approach approach
        i32 approach_mm
        BusStop stop
        TurnRule rule
        bool filter
    }
    LANE {
        u32_list to "arm uids reachable"
    }
    CROSSING {
        i32 setback_mm
        i32 width_mm
        bool island
    }
